# Hermes API server (enable with API_SERVER_ENABLED=true in ~/.hermes/.env, then `hermes gateway`)
HERMES_URL=http://127.0.0.1:8642
HERMES_API_KEY=same-value-as-API_SERVER_KEY
# Hermes home, read for the Bot roster (profile.yaml). Defaults to ~/.hermes
# HERMES_HOME=
# Other Bots: that profile's own API_SERVER_KEY (needs gateway.multiplex_profiles)
# HERMES_PROFILE_KEY_RESEARCHER=
# BFF listen addresses: a comma-separated list of IPv4/IPv6 addresses (or localhost), one listener each on
# BFF_PORT. Recommended: loopback plus your Tailscale address (`tailscale ip -4`), e.g.
#   BFF_HOST=127.0.0.1,100.x.y.z
# 127.0.0.1 alone is enough with `adb reverse` over USB. Prefer 127.0.0.1 to `localhost`, which binds just one
# resolved address (possibly IPv6 only). If an address can't be bound the BFF refuses to start.
# Unset means 0.0.0.0 (every interface): don't use it on a shared network, the device token is the only gate.
BFF_HOST=127.0.0.1
BFF_PORT=8787
# Generated by `pnpm pair`
DEVICE_TOKEN=
# URL scheme of the pairing link `pnpm pair` prints. Only for a fork build: use the same value as
# APP_SCHEME when building the app (see "Building your own version" in the root README). Defaults to hermesmobile.
# APP_SCHEME=
