{
  "name": "hermes-mobile",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=24" },
  "scripts": {
    "bff": "pnpm --filter @hermes-mobile/bff dev",
    "pair": "pnpm --filter @hermes-mobile/bff pair",
    "mobile": "pnpm --filter @hermes-mobile/mobile start",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "pnpm --filter @hermes-mobile/mobile lint",
    "hygiene": "node scripts/hygiene.mjs",
    "validate": "node scripts/validate.mjs",
    "prepare": "node scripts/prepare.mjs"
  },
  "devDependencies": {
    "lefthook": "^2.2.2"
  }
}
